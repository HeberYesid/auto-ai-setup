{
  "name": "auto-ai-setup",
  "version": "0.1.0",
  "description": "Local, consent-driven AI agent project setup CLI",
  "keywords": [
    "ai",
    "cli",
    "kiro",
    "mcp",
    "developer-tools",
    "project-setup",
    "typescript"
  ],
  "homepage": "https://github.com/HeberYesid/auto-ai-setup#readme",
  "bugs": {
    "url": "https://github.com/HeberYesid/auto-ai-setup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeberYesid/auto-ai-setup.git"
  },
  "license": "MIT",
  "author": "Heber Yesid <heberyesiddazatoloza@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "auto-ai-setup": "dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contracts": "./dist/domain/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "pnpm exec prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{js,json,jsonc,md,yml,yaml}\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{js,json,jsonc,md,yml,yaml}\"",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "typecheck": "pnpm exec tsc -p tsconfig.test.json --noEmit",
    "test:unit": "pnpm exec vitest run --exclude \"tests/**/*.property.test.ts\" --exclude \"tests/cli-session.test.ts\" --exclude \"tests/transaction-engine.test.ts\"",
    "test:integration": "pnpm exec vitest run tests/cli-session.test.ts tests/transaction-engine.test.ts",
    "test:property": "node scripts/run-property-tests.mjs",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:property",
    "test:coverage": "pnpm exec vitest run --coverage",
    "build": "pnpm run clean && pnpm exec tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "pack": "pnpm run build && pnpm pack --pack-destination .artifacts",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "traceability": "pnpm run build && node dist/infrastructure/traceability/cli.js",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:integration && pnpm run test:property && pnpm run test:coverage && pnpm run build && pnpm run pack && pnpm run smoke && pnpm run traceability"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.16.0",
    "fast-check": "3.23.2",
    "prettier": "3.9.6",
    "typescript": "5.7.2",
    "typescript-eslint": "8.65.0",
    "vitest": "2.1.8"
  }
}
